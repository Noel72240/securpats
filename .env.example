# Supabase (backend — Auth, DB, Storage)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...
# Service role — backend Vercel uniquement (webhooks Stripe, admin)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Application
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_EMAIL=admin@securpats.fr

# Stripe — clé publique (frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — Price IDs des abonnements récurrents
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_YEARLY=price_...
VITE_STRIPE_PRICE_PETSITTER_VIP=price_...

# Stripe — clés secrètes (backend Vercel uniquement)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Notifications urgence — email (Resend, obligatoire pour les alertes email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=contact@securpats.fr
# Réponses aux relances disponibilités (optionnel)
# RESEND_REPLY_TO=contact@securpats.fr

# Cron Vercel — relance disponibilités tous les 15 j (recommandé en prod)
# CRON_SECRET=une_chaine_aleatoire_longue

# Notifications urgence — SMS optionnel (Twilio)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+33...

# Mondial Relay — Connect API V2 (Dual Carrier, étiquettes) — Vercel uniquement, jamais VITE_*
# MONDIAL_RELAY_API_KEY=clé_publique_uuid
# MONDIAL_RELAY_API_SECRET=clé_secrete
# Mondial Relay — Webservices API1 (recherche Point Relais) — page « Webservices (API, Module) »
# MONDIAL_RELAY_ENSEIGNE=XXXXXXXX
# MONDIAL_RELAY_PRIVATE_KEY=...
# MONDIAL_RELAY_BRAND_CODE=41
